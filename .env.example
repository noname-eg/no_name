# Server-only Supabase credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-new-service-role-key

# Production frontend origin, for example https://store.example.com
APP_ORIGIN=http://localhost:8080

# Set to production when deployed behind HTTPS
NODE_ENV=development

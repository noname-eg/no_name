# Server-only Supabase credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-new-service-role-key

# Set this to the exact deployed frontend origin. Keep localhost only for local development.
APP_ORIGIN=https://your-production-domain.example

# Use production behind HTTPS; use development locally.
NODE_ENV=production

# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or any VITE_* variable.

# Server-only values. Never expose these through VITE_* variables.
# Copy this file to .env for local development. Do not put secrets in .env.example.
# Use the project URL only, without /rest/v1.
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret from Supabase; never expose it as a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:8080
NODE_ENV=development
